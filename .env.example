# Server-side Supabase PostgreSQL connection string. Never expose this in Vite
# variables or commit a real password. The Supabase dashboard provides the
# complete URI, including the pooler username and URL-encoded password.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-database-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Public project URL only. An anon key is needed only if a future browser-side
# Supabase client is introduced; the current app uses the secure server API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
